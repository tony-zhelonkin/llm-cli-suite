#!/usr/bin/env bash
# gpu-switch — mutually-exclusive GPU tenancy for the single 32GB card.
#
# WHY: Phase 0 (2026-07-26) measured DiffusionGemma FP8 at ~31GB resident. A
# resident Ollama model is 15-23GB. They cannot co-reside on one 32GB card, so
# the GPU hosts exactly ONE server at a time. This flips between them safely:
# stop the outgoing tenant, WAIT for the card to actually drain, then start the
# incoming one. Single-user station — stopping either service freely is fine.
#
#   gpu-switch ollama      # Ollama resident (the default coding tier)
#   gpu-switch diffusion   # DiffusionGemma resident (:11435, experimental)
#   gpu-switch off         # free the GPU (stop both)
#   gpu-switch status      # who holds the card
#
# Needs sudo for systemctl. Every privileged command is ECHOED before it runs
# (via run()) so nothing sudo happens invisibly — you see exactly what executes.
set -euo pipefail

# Print then execute — makes all privileged actions observable.
run() { echo "  \$ $*"; "$@"; }

DIFFUSION_UNIT=diffusiongemma.service
OLLAMA_UNIT=ollama.service
FREE_MIB=1500          # consider the card "free" below this (CUDA ctx leaves a little)
WAIT_SECS=60
PORT=11435             # diffusion vLLM port (readiness poll)

gpu_used_mib() { nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1 | tr -d ' '; }

wait_until_free() {
  local waited=0 used
  used=$(gpu_used_mib)
  # Already free — say so and return, so the caller never looks hung.
  (( used <= FREE_MIB )) && { echo "   GPU already free (${used} MiB)."; return 0; }
  printf '   draining GPU'
  while (( used > FREE_MIB )); do
    if (( waited >= WAIT_SECS )); then
      echo; echo "⚠️  GPU still shows ${used} MiB after ${WAIT_SECS}s — a non-systemd process may hold it; check 'nvidia-smi'." >&2
      return 1
    fi
    printf ' %sMiB' "$used"       # live: show the memory actually falling
    sleep 3; waited=$((waited+3)); used=$(gpu_used_mib)
  done
  echo " → free (${used} MiB)."
}

status() {
  echo "GPU used: $(gpu_used_mib) MiB / 32760"
  for u in "$OLLAMA_UNIT" "$DIFFUSION_UNIT"; do
    printf '  %-24s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || echo inactive)"
  done
}

case "${1:-}" in
  diffusion)
    echo "→ freeing GPU from Ollama…"
    run sudo systemctl stop "$OLLAMA_UNIT" 2>/dev/null || true
    wait_until_free
    echo "→ starting DiffusionGemma (loads ~26GB, ~1-2 min)…"
    run sudo systemctl start "$DIFFUSION_UNIT"
    # Type=simple returns instantly; the model still needs ~90s to load. Poll until it
    # actually answers so this command doesn't lie about readiness.
    printf '   loading'
    for i in $(seq 1 60); do
      if curl -sf "localhost:$PORT/v1/models" >/dev/null 2>&1; then
        echo " ✓ ready — :$PORT/v1/models responds"; exit 0
      fi
      systemctl is-active --quiet "$DIFFUSION_UNIT" || { echo; echo "✗ service died — journalctl -u $DIFFUSION_UNIT" >&2; exit 1; }
      printf '.'; sleep 3
    done
    echo; echo "⚠️  still not ready after 180s — check: journalctl -fu $DIFFUSION_UNIT" >&2
    ;;
  ollama)
    echo "→ freeing GPU from DiffusionGemma…"
    run sudo systemctl stop "$DIFFUSION_UNIT" 2>/dev/null || true
    wait_until_free
    echo "→ starting Ollama…"
    run sudo systemctl start "$OLLAMA_UNIT"
    ;;
  off)
    run sudo systemctl stop "$DIFFUSION_UNIT" "$OLLAMA_UNIT" 2>/dev/null || true
    wait_until_free && echo "GPU freed."
    ;;
  status|"") status ;;
  *) echo "usage: gpu-switch {ollama|diffusion|off|status}" >&2; exit 2 ;;
esac
