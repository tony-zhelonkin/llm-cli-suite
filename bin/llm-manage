#!/bin/bash
# Model Management Script
# Architecture: Single-model residency for GPU efficiency.

COMMAND=$1
TARGET=$2
CTX=${3:-32768}
export PATH="$PATH:$HOME/.local/bin"

# 1. Alias Resolution
case "$TARGET" in
    "gemma") MODEL="gemma4:31b" ;;
     "qwen3.6-dense") MODEL="batiai/qwen3.6-27b:iq4" ;;
    "fuse")  MODEL="Sub01/FuseO1-DeepSeekR1-QwQ-SkyT1-Flash-32B-Preview:q4_K_M" ;;
    "r1")    MODEL="hengwen/DeepSeek-R1-Distill-Qwen-32B:q4_K_M" ;;
     "qwen3.6-moe") MODEL="qwen3.6:35b" ;;
    *)       MODEL="$TARGET" ;;
esac

# 2. Logic: Flush (Unload everything)
function flush_all() {
    echo "🧹 Clearing VRAM (Unloading all models)..."
    ollama ps | tail -n +2 | awk '{print $1}' > /tmp/loaded_models.txt
    while read m; do
        if [ -n "$m" ]; then
            curl -s http://localhost:11434/api/generate -d "{\"model\": \"$m\", \"keep_alive\": 0}" > /dev/null
            echo "  - Unloaded $m"
        fi
    done < /tmp/loaded_models.txt
}

# 3. Logic: Load (Ensures clean state then pulls into VRAM)
function load_model() {
    local m_target=$1
    local c_target=$2

    # Interactive selector if no model provided
    if [ -z "$m_target" ]; then
        echo "Fetching available models..."
        ollama list | tail -n +2 | awk '{print $1}' > /tmp/ollama_models.txt
        m_target=$(cat /tmp/ollama_models.txt | fzf --prompt="Select model to LOAD (Context: $c_target): " --height=15 --reverse)
        if [ -z "$m_target" ]; then echo "Cancelled."; exit 0; fi
    fi

    flush_all
    
    echo "🚀 Loading $m_target (Context: $c_target)..."
    sys-notify "Workstation: LLM Mapping" "Initiating mapping for $m_target (Ctx: $c_target)."
    
    # Trigger API load
    curl -s http://localhost:11434/api/generate -d "{\"model\": \"$m_target\", \"keep_alive\": -1, \"options\": {\"num_ctx\": $c_target}}" > /dev/null &
    
    # Watcher Logic
    local WATCHER_FILE=$(mktemp /tmp/llm_watcher_XXXXXX.sh)
    echo '#!/bin/bash' > "$WATCHER_FILE"
    echo "MODEL_W=$m_target" >> "$WATCHER_FILE"
    echo "CTX_W=$c_target" >> "$WATCHER_FILE"
    echo "while true; do" >> "$WATCHER_FILE"
    echo '  PID=$(pgrep -f "ollama runner.*$MODEL_W" | head -n 1)' >> "$WATCHER_FILE"
    echo '  [ -n "$PID" ] && break' >> "$WATCHER_FILE"
    echo '  sleep 5' >> "$WATCHER_FILE"
    echo "done" >> "$WATCHER_FILE"
    echo "THRESHOLD=15000000" >> "$WATCHER_FILE"
    echo "while true; do" >> "$WATCHER_FILE"
    echo '  [ ! -d "/proc/$PID" ] && break' >> "$WATCHER_FILE"
    echo '  RSS=$(grep VmRSS /proc/$PID/status | awk "{print \$2}")' >> "$WATCHER_FILE"
    echo '  if [ "$RSS" -ge "$THRESHOLD" ]; then' >> "$WATCHER_FILE"
    echo '    sys-notify "Workstation: LLM HOT" "🚀 $MODEL_W (Ctx: $CTX_W) is ready."' >> "$WATCHER_FILE"
    echo "    break" >> "$WATCHER_FILE"
    echo "  fi" >> "$WATCHER_FILE"
    echo "  sleep 15" >> "$WATCHER_FILE"
    echo "done" >> "$WATCHER_FILE"
    echo 'rm "$0"' >> "$WATCHER_FILE"
    
    bash "$WATCHER_FILE" & disown
}

# 4. Main Router
if [ "$COMMAND" = "load" ]; then
    load_model "$MODEL" "$CTX"
elif [ "$COMMAND" = "flush" ]; then
    flush_all
    sys-notify "Workstation: LLM Clear" "VRAM cleared."
else
    echo "Usage: llm-manage [load|flush] [alias|model] [num_ctx]"
    echo ""
    echo "Aliases: gemma, qwen3.6-dense, qwen3.6-moe, fuse, r1"
    echo "Example: llm-manage load qwen3.6-dense 16384"
fi
