#!/bin/bash
# Project Sync Tool
# Dynamically discovers Devcontainers and propagates the master setup script

MASTER="$HOME/.scripts/master_setup_pi.sh"
# The provider model lists are separate files (single sources of truth) shipped
# next to the installer so master_setup_pi.sh can read them inside the container.
MODELS="$(dirname "$MASTER")/providers"

# Define the root directories where I keep my projects.
# LLM_SYNC_ROOTS overrides them — colon-separated like PATH, so a path with
# spaces survives; a leading ~ is expanded even when it arrives quoted. On a Mac:
#   LLM_SYNC_ROOTS="~/projects:~/Documents/My Projects" llm-sync
# Roots that don't exist on this box are skipped silently.
if [ -n "${LLM_SYNC_ROOTS:-}" ]; then
    IFS=':' read -r -a RAW_ROOTS <<< "$LLM_SYNC_ROOTS"
    WORKSPACE_ROOTS=()
    for R in "${RAW_ROOTS[@]}"; do
        case "$R" in
            "~")   R="$HOME" ;;
            "~/"*) R="$HOME/${R#\~/}" ;;
        esac
        WORKSPACE_ROOTS+=("$R")
    done
else
    WORKSPACE_ROOTS=(
        "/data1/users/antonz/projects"
        "/scratch/current/antonz/projects"
        "/data2/users"
    )
fi

if [ ! -f "$MASTER" ]; then
    echo "⚠️ Error: Master script $MASTER not found."
    exit 1
fi

echo "🔍 Scanning for Devcontainers in workspaces..."

# Find all directories named ".devcontainer" up to 4 levels deep from the roots
# Level 4 allows for /data2/users/antonz/projects/myproject/.devcontainer
FOUND_DEVCONTAINERS=()
for ROOT in "${WORKSPACE_ROOTS[@]}"; do
    if [ -n "$ROOT" ] && [ -d "$ROOT" ]; then
        # Read the output of find into an array safely
        while IFS= read -r -d $'\0' dir; do
            FOUND_DEVCONTAINERS+=("$dir")
        done < <(find "$ROOT" -maxdepth 4 -type d -name ".devcontainer" -not -path "*/.ref/*" -print0 2>/dev/null)
    fi
done

if [ ${#FOUND_DEVCONTAINERS[@]} -eq 0 ]; then
    echo "⚠️ No Devcontainers found in the defined workspaces."
    exit 0
fi

echo "🔄 Syncing Pi Setup Master to ${#FOUND_DEVCONTAINERS[@]} projects..."

for DEV_DIR in "${FOUND_DEVCONTAINERS[@]}"; do
    # Target path: project/.devcontainer/scripts/setup_pi.sh
    TARGET="$DEV_DIR/scripts/setup_pi.sh"
    
    mkdir -p "$(dirname "$TARGET")"
    cp "$MASTER" "$TARGET"
    # Ship all provider lists next to the installer for in-container rendering.
    if compgen -G "$MODELS/*.json" > /dev/null; then
        mkdir -p "$(dirname "$TARGET")/providers"
        cp "$MODELS"/*.json "$(dirname "$TARGET")/providers/"
    fi
    echo "✅ Synced: $TARGET"
done

echo "🎉 Sync complete. Devcontainers are now ready for rebuild."
