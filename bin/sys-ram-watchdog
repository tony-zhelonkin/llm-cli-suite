#!/bin/bash
# Resource Watchdog Script
# Monitors RAM/VRAM usage and alerts statefully to avoid spam.
# VRAM is only watched where nvidia-smi exists; on a Mac the RAM figure already
# is the GPU's memory (unified). `--once` runs a single pass, for testing.

export PATH="$PATH:$HOME/.local/bin"
SELF="${BASH_SOURCE[0]}"; while [ -L "$SELF" ]; do D="$(cd -P "$(dirname "$SELF")" && pwd)"; SELF="$(readlink "$SELF")"; case "$SELF" in /*) ;; *) SELF="$D/$SELF" ;; esac; done
. "$(cd -P "$(dirname "$SELF")/.." && pwd)/lib/platform.sh"

RAM_WARN_LEVEL=0
VRAM_WARN_LEVEL=0

while true; do
    # Get RAM usage percentage
    read -r RAM_USED RAM_TOTAL <<< "$(plat_mem_mib)"
    RAM_PERCENT=$(( 100 * RAM_USED / RAM_TOTAL ))

    # RAM Logic (Stateful)
    if [ "$RAM_PERCENT" -ge 99 ] && [ "$RAM_WARN_LEVEL" -lt 99 ]; then
        sys-notify "⚠️ CRITICAL: System RAM at ${RAM_PERCENT}%" "Workstation RAM is maxed out. Severe OOM risk."
        RAM_WARN_LEVEL=99
    elif [ "$RAM_PERCENT" -ge 90 ] && [ "$RAM_WARN_LEVEL" -lt 90 ]; then
        sys-notify "⚠️ WARNING: System RAM at ${RAM_PERCENT}%" "RAM threshold crossed. Pipelines may be constrained."
        RAM_WARN_LEVEL=90
    elif [ "$RAM_PERCENT" -lt 85 ]; then
        RAM_WARN_LEVEL=0 # Reset when it cools down
    fi

    # VRAM Logic (Stateful) — only with an NVIDIA card
    read -r VRAM_USED VRAM_TOTAL <<< "$(plat_vram_mib)"
    if [ -n "$VRAM_TOTAL" ]; then
        VRAM_PERCENT=$(( 100 * VRAM_USED / VRAM_TOTAL ))
        if [ "$VRAM_PERCENT" -ge 99 ] && [ "$VRAM_WARN_LEVEL" -lt 99 ]; then
            sys-notify "⚠️ CRITICAL: GPU VRAM at ${VRAM_PERCENT}%" "GPU VRAM is nearly full."
            VRAM_WARN_LEVEL=99
        elif [ "$VRAM_PERCENT" -ge 90 ] && [ "$VRAM_WARN_LEVEL" -lt 90 ]; then
            sys-notify "⚠️ WARNING: GPU VRAM at ${VRAM_PERCENT}%" "VRAM threshold crossed."
            VRAM_WARN_LEVEL=90
        elif [ "$VRAM_PERCENT" -lt 85 ]; then
            VRAM_WARN_LEVEL=0 # Reset when it cools down
        fi
    fi

    [ "${1:-}" = --once ] && { echo "RAM ${RAM_PERCENT}%${VRAM_TOTAL:+ | VRAM ${VRAM_PERCENT}%}"; break; }
    sleep 60
done
